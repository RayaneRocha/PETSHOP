{
  "name": "petshop-ecommerce",
  "version": "1.0.0",
  "description": "API REST e site Web de um e-commerce de pet shop (login, cadastro, carrinho e finalização de compra).",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec \"cypress/e2e/**/*.cy.js\"",
    "test:e2e": "cypress run --spec \"cypress/e2e/**/*.cy.js\"",
    "cy:run:headed": "cypress run --headed --browser chrome --spec \"cypress/e2e/**/*.cy.js\"",
    "perf:load": "k6 run performance/load-test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "petshop",
    "ecommerce",
    "express",
    "mongodb-memory-server",
    "swagger"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.4",
    "mongoose": "^8.9.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cypress": "^14.0.0",
    "cypress-mochawesome-reporter": "^3.8.2"
  }
}
